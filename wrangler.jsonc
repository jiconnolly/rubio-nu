{
  // Configuración de despliegue del sitio de Club Rubio Ñu en Cloudflare.
  // Sitio estático: no hay build ni código de servidor.
  //
  // El worker de datos en vivo (worker/index.js) quedó escrito pero SIN USAR:
  // el plan gratuito de API-Football no da acceso a la temporada 2026.
  // Para activarlo hace falta un plan pago; entonces se agrega de nuevo
  // "main": "worker/index.js" y el binding ASSETS.
  "name": "rubio-nu",
  "compatibility_date": "2026-09-08",
  "preview_urls": false,
  "assets": {
    "directory": "./",
    "not_found_handling": "404-page"
  }
}
